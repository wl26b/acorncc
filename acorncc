#!/bin/sh
# Entry point invoked by the test suite (as ../acorncc) and by hand. Resolves its
# own directory so it works regardless of the caller's cwd, then runs the
# TypeScript driver directly via tsx (no build step).
DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/node_modules/.bin/tsx" "$DIR/src/main.ts" "$@"
