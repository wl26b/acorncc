{
  "name": "acorncc",
  "version": "0.0.1",
  "description": "acorncc — a compiler for a useful subset of C, targeting ARM64, written in TypeScript.",
  "type": "module",
  "bin": {
    "acorncc": "./acorncc"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "cd writing-a-c-compiler-tests && ./test_compiler ../acorncc --expected-error-codes 1",
    "test:ch1": "npm test -- --chapter 1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.9.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
